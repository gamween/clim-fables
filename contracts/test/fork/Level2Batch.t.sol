pragma solidity ^0.8.26;

import {Test} from "forge-std/Test.sol";
import {IAccessManager} from "@openzeppelin/contracts/access/manager/IAccessManager.sol";

import {RiskDeskV2} from "../../src/v2/RiskDeskV2.sol";
import {ClimFeePolicy} from "../../src/v2/ClimFeePolicy.sol";
import {ClimPoker} from "../../src/v2/ClimPoker.sol";
import {ClimFeeMath} from "../../src/libraries/ClimFeeMath.sol";
import {ISymmetricPokeHook} from "../../src/v2/interfaces/IOverrideFeeHook.sol";

/// @notice Sends the calldata of docs/integrate/level2-batch.fork.json (generated by docs/integrate/level2-batch.ts from
///         the compiled ABIs) to Fables' real AccessManager on a Robinhood Chain mainnet fork, as Fables' admin, then
///         checks what it grants and what its revocation calldata undoes. Nothing is sent to mainnet.
contract Level2BatchForkTest is Test {
    uint256 internal constant FORK_BLOCK = 87_780_000;
    address internal constant HOOK = 0x06a889870C8f83640D6816319f72e2aA579b6080;
    address internal constant ACCESS_MANAGER = 0xA362D98B33A7bb5B5E2180a05f995A70FB404f30;
    address internal constant FABLES_ADMIN = 0x359856655934338d798F9ccE1f181486301D36a5;
    bytes32 internal constant POOL_ID = 0xbac3aa3b91584a53a579b3c999a56756e954e59247e497bad1d25a4334bde551;
    uint64 internal constant FEE_POKER = 1;
    uint64 internal constant CLIM_RUNNER = 7;
    uint32 internal constant SIGMA_48 = 85_475;
    uint32 internal constant ETA_E4 = 25_093;
    uint32 internal constant SQRT_HALF_DT_E6 = 707_107;

    string internal json;
    address internal poker;
    address internal runner;
    address internal keeper;
    RiskDeskV2 internal desk;
    address internal forwarder = makeAddr("forwarder");
    address internal operator = makeAddr("operator");

    function setUp() public {
        string memory rpc = vm.envOr("RH_MAINNET_RPC_URL", string(""));
        if (bytes(rpc).length == 0) vm.skip(true);
        vm.createSelectFork(rpc, FORK_BLOCK);
        json = vm.readFile("../docs/integrate/level2-batch.fork.json");
        assertEq(vm.parseJsonAddress(json, ".params.accessManager"), ACCESS_MANAGER);
        poker = vm.parseJsonAddress(json, ".params.poker");
        address[] memory runners = vm.parseJsonAddressArray(json, ".params.runners");
        runner = runners[0];
        keeper = runners[1];

        desk = new RiskDeskV2(forwarder, operator);
        ClimFeePolicy policy = new ClimFeePolicy(
            desk,
            ClimFeePolicy.Params({
                etaE4: ETA_E4,
                sqrtHalfDtE6: SQRT_HALF_DT_E6,
                floorPips: 700,
                capPips: 6_000,
                safePips: 3_000,
                tauKillSec: 180,
                shortWindow: false,
                dirSlopeE4: 0,
                dirMaxPremiumPips: 0,
                ethIsToken0: true
            })
        );
        // ClimPoker at the address the batch names (on mainnet it is wherever ClimPoker gets deployed)
        deployCodeTo(
            "ClimPoker.sol:ClimPoker", abi.encode(policy, HOOK, POOL_ID, false, uint40(600), ACCESS_MANAGER), poker
        );
        vm.prank(forwarder, operator);
        desk.onReport(
            "", abi.encode(uint40(block.timestamp), SIGMA_48, SIGMA_48, int32(0), uint16(3), uint8(4), uint16(10_000))
        );
    }

    function _send(address from, bytes memory data) internal returns (bool ok) {
        vm.prank(from);
        (ok,) = ACCESS_MANAGER.call(data);
    }

    function _callData(string memory path) internal view returns (bytes memory) {
        return vm.parseJsonBytes(json, path);
    }

    function test_FablesAdminSendsTheMulticallAndThePokerWorks() public {
        assertTrue(_send(FABLES_ADMIN, _callData(".multicall.data")));
        IAccessManager am = IAccessManager(ACCESS_MANAGER);
        assertEq(am.getTargetFunctionRole(poker, ClimPoker.poke.selector), CLIM_RUNNER);
        assertEq(am.getTargetFunctionRole(poker, ClimPoker.postEvent.selector), FEE_POKER);
        assertEq(am.getTargetFunctionRole(poker, ClimPoker.postEventAndPoke.selector), FEE_POKER);
        (bool member,) = am.hasRole(FEE_POKER, poker);
        assertTrue(member);
        (member,) = am.hasRole(CLIM_RUNNER, runner);
        assertTrue(member);
        (member,) = am.hasRole(CLIM_RUNNER, keeper);
        assertTrue(member);

        vm.prank(runner);
        ClimPoker(poker).poke();
        uint24 expected = ClimFeeMath.feePips(SIGMA_48, ETA_E4, SQRT_HALF_DT_E6, 10_000, 700, 6_000);
        assertEq(ISymmetricPokeHook(HOOK).currentFee(POOL_ID, true), expected);
        assertEq(ISymmetricPokeHook(HOOK).currentFee(POOL_ID, false), expected);
    }

    function test_TheCallsAlsoWorkOneByOne() public {
        uint256 n = vm.parseJsonAddressArray(json, ".params.runners").length + 4;
        for (uint256 i; i < n; i++) {
            assertTrue(_send(FABLES_ADMIN, _callData(string.concat(".calls[", vm.toString(i), "].data"))));
        }
        vm.prank(keeper);
        (uint24 f01, uint24 f10) = ClimPoker(poker).postEventAndPoke(5_000, 5_000, uint40(block.timestamp + 300));
        assertEq(f01, 5_000);
        assertEq(f10, 5_000);
        assertEq(ISymmetricPokeHook(HOOK).currentFee(POOL_ID, true), 5_000);
    }

    function test_AStrangerCannotSendTheBatch() public {
        assertFalse(_send(makeAddr("stranger"), _callData(".multicall.data")));
        (bool member,) = IAccessManager(ACCESS_MANAGER).hasRole(FEE_POKER, poker);
        assertFalse(member);
    }

    function test_RevocationStopsEveryPoke() public {
        assertTrue(_send(FABLES_ADMIN, _callData(".multicall.data")));
        assertTrue(_send(FABLES_ADMIN, _callData(".revoke.stop.data")));
        vm.prank(runner);
        vm.expectRevert();
        ClimPoker(poker).poke();
    }

    function test_CleanupRemovesTheRunners() public {
        assertTrue(_send(FABLES_ADMIN, _callData(".multicall.data")));
        assertTrue(_send(FABLES_ADMIN, _callData(".revoke.cleanup[0].data")));
        assertTrue(_send(FABLES_ADMIN, _callData(".revoke.cleanup[1].data")));
        (bool member,) = IAccessManager(ACCESS_MANAGER).hasRole(CLIM_RUNNER, runner);
        assertFalse(member);
        (member,) = IAccessManager(ACCESS_MANAGER).hasRole(CLIM_RUNNER, keeper);
        assertFalse(member);
    }

    /// @dev The hook keeps one override per pool and the last writer wins: a keeper that keeps poking the hook directly
    ///      is overwritten by the next clim poke, even with a lower fee. Hence the setup routes the keeper's event
    ///      overrides through ClimPoker (postEvent / postEventAndPoke), where they compose as max(clim, event).
    function test_ADirectKeeperPokeIsOverwrittenByTheNextClimPoke() public {
        assertTrue(_send(FABLES_ADMIN, _callData(".multicall.data")));
        vm.prank(keeper);
        ISymmetricPokeHook(HOOK).pokeFee(POOL_ID, 5_000, 7_200);
        vm.prank(runner);
        ClimPoker(poker).poke();
        uint24 clim = ClimFeeMath.feePips(SIGMA_48, ETA_E4, SQRT_HALF_DT_E6, 10_000, 700, 6_000);
        assertLt(clim, 5_000);
        assertEq(ISymmetricPokeHook(HOOK).currentFee(POOL_ID, true), clim);
    }

    function test_AnEventPostedThroughThePokerSurvivesTheNextClimPoke() public {
        assertTrue(_send(FABLES_ADMIN, _callData(".multicall.data")));
        vm.prank(keeper);
        ClimPoker(poker).postEventAndPoke(5_000, 5_000, uint40(block.timestamp + 300));
        vm.prank(runner);
        ClimPoker(poker).poke();
        assertEq(ISymmetricPokeHook(HOOK).currentFee(POOL_ID, true), 5_000);
    }
}
